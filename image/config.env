# Pinned inputs for the Orange Pi 5 (RK3588S, board rev 1.3.2) image.
# Sourced by build.sh, image/build-image.sh, image/convert-models.sh and image/customize-rootfs.sh.

IMAGE_NAME=orangepi5-viam-npu

# Base OS: Armbian Orange Pi 5, Debian 13 minimal, vendor kernel (ships the rknpu driver).
ARMBIAN_IMAGE=Armbian_26.8.1_Orangepi5_trixie_vendor_6.1.115_minimal.img.xz
ARMBIAN_URL=https://dl.armbian.com/orangepi5/archive/${ARMBIAN_IMAGE}
ARMBIAN_SHA256=8e2c7217a60888c0cf487a85d445b3ee8ea4f533c2293df12d36ccfc6437e040

# Space added to the root partition before customizing. Armbian grows it to the full card on first boot.
EXTRA_IMAGE_MB=6144

# First-boot login.
OPI_HOSTNAME=orangepi5
OPI_USER=opi

# Viam. Both binaries are the current stable channel; viam-agent updates them once the machine is bound.
VIAM_AGENT_URL=https://storage.googleapis.com/packages.viam.com/apps/viam-agent/viam-agent-stable-aarch64
VIAM_SERVER_URL=https://storage.googleapis.com/packages.viam.com/apps/viam-server/viam-server-stable-aarch64
VIAM_PREINSTALL_URL=https://storage.googleapis.com/packages.viam.com/apps/viam-agent/preinstall.sh

# Rockchip NPU runtime (librknnrt) and Python bindings.
RKNN_VERSION=2.3.2
RKNNRT_URL=https://raw.githubusercontent.com/airockchip/rknn-toolkit2/v${RKNN_VERSION}/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so

# YOLOv8 ONNX exports from the Rockchip model zoo, converted to RK3588 INT8 by image/convert-models.sh.
RKNN_MODEL_ZOO_REF=bad6c7334531becaf90a561988519b7bec34d0ab
YOLO_ONNX_BASE=https://ftrg.zbox.filez.com/v2/delivery/data/95f00b0fc900458ba134f8b180b3f7a1/examples

# FastSAM-s promptable masks. Ultralytics weights; image/fastsam_onnx.py cuts the head and
# image/fastsam_rknn.py quantizes it. The graph names are ultralytics 8.4, opset 12, simplify off.
FASTSAM_PT_URL=https://github.com/ultralytics/assets/releases/download/v8.3.0/FastSAM-s.pt
FASTSAM_PT_SHA256=c9f78716a81c7aff0d608ccc73e1b82ab3aaad86005049f6a92106a0be6d0844
FASTSAM_ULTRALYTICS=8.4.45

# LightStereo-S (SceneFlow), optimized ONNX at 256x512, converted to RK3588 fp16.
# One copy per NPU core during an explore run. See opibot/lightstereo.py.
LIGHTSTEREO_ONNX_URL=https://raw.githubusercontent.com/zz990099/lightstereo_cpp/master/models/lightstereo_s_sceneflow_general_opt_256_512.onnx
LIGHTSTEREO_ONNX_SHA256=b80e9986bd89213417680eda993a2e58dda55153812987e911e741d3d6be0da4

# InternVL3.5-1B look-and-describe: RKLLM 1.2.3 runtime + demo sources, and the preconverted RK3588 weights.
VLM_SRC_REPO=Qengineering/InternVL3.5-1B-NPU
VLM_SRC_REF=e98774534f550ace6b903a56dc3e25ac12306546
VLM_HF_REPO=Qengineering/InternVL3.5-1B-rk3588
VLM_HF_REV=9a031632da2a3057726f9a1e7b5cabcbecab784e
VLM_VISION_FILE=internvl3_5-1b_vision_rk3588.rknn
VLM_VISION_SHA256=c52be0b277c56096eb499975614f72ff497dc5e86250b26dd8b3b7ff232a7b93
VLM_LLM_FILE=internvl3_5-1b-instruct_w8a8_rk3588.rkllm
VLM_LLM_SHA256=b6aee283a9029751a714813c1ff64b5da0cad72bb17eb943321f53ddb6e2ac68

# Qwen2.5-1.5B-Instruct, text only, for the dashboard's Project tab (llm-ask). Converted with RKLLM 1.2.3, the
# runtime above. Apache-2.0. About 2 GB while loaded; it loads for a writing job and unloads after.
WRITER_HF_REPO=HanzoHuang/Qwen2.5-1.5B-Instruct-RKLLM
WRITER_HF_REV=aa7d7fb29b26faae20e46a51b829e6a2db68c42d
WRITER_HF_PATH=RK3588/Qwen2.5-1.5B-Instruct_RK3588_w8a8.rkllm
WRITER_FILE=Qwen2.5-1.5B-Instruct_RK3588_w8a8.rkllm
WRITER_SHA256=e296d41ff1ff64f86e293227f15e35520dbeacebb74d21592a0790919691ca2d

# Seeed reBot Arm B601-RS kinematics (URDF), read by the Viam arm module.
REBOT_REPO=Seeed-Projects/reBotArm_control_py
REBOT_REF=6415d43130d1e143c70dc106096a857ac5556f81
REBOT_URDF=urdf/RS/urdf/ReBot_Arm_RS.urdf
REBOT_URDF_SHA256=3838ca8f9d586be22a89b33c7cbdd4abd43d4a92a2de377b294eef4c5bd7654d

# On-device Python. rknn-toolkit-lite2 publishes wheels up to cp312; Debian 13 ships 3.13.
OPI_PYTHON=3.12
OPI_PIP_PACKAGES="rknn-toolkit-lite2==${RKNN_VERSION} numpy<2 opencv-python-headless==4.10.0.84 viam-sdk==0.84.0 motorbridge==0.5.6 pyyaml==6.0.2 open3d==0.20.0 paho-mqtt==2.1.0"
